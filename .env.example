# Runtime switches
MOCK_MODE=true
ENABLE_LIVE=false

# Gemini access. GOOGLE_API_KEY is optional when using Vertex AI credentials.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Model IDs are deployment configuration; never hardcode them in application code.
MODEL_EXPLAIN=gemini-3-flash-preview
MODEL_EXPLAIN_FALLBACK=gemini-3.5-flash-lite
MODEL_TTS=gemini-3.1-flash-tts-preview
MODEL_LIVE=gemini-3.1-flash-live-preview

# App behavior
FIRESTORE_COLLECTION=rooms
CORS_ORIGINS=http://localhost:3000

# Browser-visible service locations
# Largest audio lookback window offered at capture time (seconds); the
# ring buffer is sized to this. The user picks 30s/60s/120s per capture,
# not a single fixed duration.
NEXT_PUBLIC_AUDIO_WINDOW_S=120
NEXT_PUBLIC_BACKEND_HTTP_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/ws

# Cloud Run deployment defaults used by infra/*.sh
GOOGLE_CLOUD_REGION=us-central1
ARTIFACT_REPOSITORY=glance
BACKEND_SERVICE=glance-backend
FRONTEND_SERVICE=glance-frontend
BUILD_SERVICE_ACCOUNT=glance-build
RUNTIME_SERVICE_ACCOUNT=glance-runtime
PUBLIC_DEMO=false
VERIFY_DEPLOY=true
